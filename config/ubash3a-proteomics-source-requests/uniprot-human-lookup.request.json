{
  "_service": "uniprot",
  "base_url": "https://rest.uniprot.org",
  "path": "uniprotkb/search",
  "params": {
    "query": "organism_id:9606",
    "fields": "accession,gene_names",
    "size": 10,
    "format": "json"
  },
  "record_path": "results",
  "max_items": 10,
  "max_depth": 1,
  "save_raw": true,
  "raw_output_path": "data/raw/ubash3a-proteomics-specificity/uniprot-human-lookup.json",
  "timeout_sec": 60
}
