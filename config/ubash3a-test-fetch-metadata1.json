      "url": "https://nmdrht.uni-koeln.de/"
    },
    {
      "source_id": "upf1-longread-repository-metadata",
      "file": "upf1-longread-repository-metadata.html",
      "url": "https://edoc.mdc-berlin.de/id/eprint/25704/"
    },
    {
      "source_id": "trails-paper-xml",
